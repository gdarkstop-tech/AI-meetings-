{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@alia/core": ["packages/core/src/index.ts"],
      "@alia/db": ["packages/db/src/index.ts"],
      "@alia/observability": ["packages/observability/src/index.ts"],
      "@alia/pipeline": ["packages/pipeline/src/index.ts"],
      "@alia/policy": ["packages/policy/src/index.ts"],
      "@alia/providers": ["packages/providers/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*", "apps/*/src/**/*", "scripts/**/*", "test/**/*", "*.config.ts", "apps/web/vite.config.ts"]
}
