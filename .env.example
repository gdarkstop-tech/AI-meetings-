# ---- Phase 1: required ----
# PostgreSQL 16 with pg_trgm, unaccent and vector extensions available.
DATABASE_URL=postgresql://postgres@127.0.0.1:55432/alia_dev
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:55432/alia_test


NODE_ENV=development
PORT=4000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:5173

# ---- NOT CONFIGURED in Phase 1 ----
# Leaving these unset is the supported state. Every provider below reports
# NOT_CONFIGURED through /api/v1/system/capabilities and every call throws
# ProviderNotConfiguredError. Nothing is mocked or faked.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ASR_PROVIDER=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ASSEMBLYAI_API_KEY=
OPENAI_API_KEY=
EMBEDDINGS_PROVIDER=
STORAGE_PROVIDER=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
EMAIL_PROVIDER=
CALENDAR_PROVIDER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
WEB_SEARCH_PROVIDER=
