# ---------------------------------------------------------------- required
# PostgreSQL 16+ with pg_trgm, unaccent and pgvector.
DATABASE_URL=postgresql://postgres@127.0.0.1:55432/alia_dev
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:55432/alia_test

# 32 random bytes, base64. Integration tokens are encrypted with this key.
# Generate: openssl rand -base64 32
# Losing it means every connected account must be reconnected.
SECRETS_KEY=

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:5173

# Public HTTPS origin of the deployment. Required before OAuth can be used:
# it is what Google and Microsoft redirect back to.
PUBLIC_BASE_URL=

# ---------------------------------------------------------------- storage
# Meeting media. Without this, uploads report NOT_CONFIGURED.
#
#   local -> filesystem, for development and tests run outside containers
#   s3    -> S3-compatible object storage; this is the container/production path
#            (docker compose, fly.toml and render.yaml all use it)
#
# Containers run as an unprivileged user and mount no writable data volume, so
# STORAGE_PROVIDER=local is not supported inside them.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./.data/media

# Required when STORAGE_PROVIDER=s3 (all four; compose refuses to start without them).
# Supply your own values — nothing here is a default.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: leave empty for AWS S3. Set it for Cloudflare R2, MinIO or another
# S3-compatible endpoint; path-style addressing turns on automatically when set.
S3_ENDPOINT=

# ---------------------------------------------------------------- speech-to-text
# deepgram | elevenlabs | openai. Benchmark on your own Arabic audio before
# committing (docs/04-ai-pipeline.md §5).
ASR_PROVIDER=
ASR_MODEL=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------- analysis
LLM_PROVIDER=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_EFFORT=high

# ---------------------------------------------------------------- semantic search
# Without embeddings, search still works: it degrades to keyword search and
# says so in the UI.
EMBEDDINGS_PROVIDER=
EMBEDDINGS_MODEL=text-embedding-3-small

# ---------------------------------------------------------------- integrations
# Calendar and email. Sending always requires human approval regardless.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ---------------------------------------------------------------- research
WEB_SEARCH_PROVIDER=
TAVILY_API_KEY=

# ---------------------------------------------------------------- operations
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=1
WORKER_SWEEP_INTERVAL_MS=3600000
MAX_UPLOAD_BYTES=4294967296
UPLOAD_CHUNK_SIZE=8388608
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_AI_MAX=60
# Bearer token guarding /metrics when it is reachable from outside.
METRICS_TOKEN=
